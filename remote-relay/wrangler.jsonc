{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slide-remote",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://present.bynoor.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
